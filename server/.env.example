# Server Port
PORT=5000

# PostgreSQL Database Configuration
# You can provide either DATABASE_URL or the individual DB_* variables
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sweety
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=sweety

# Test Database Configuration (used by Jest tests)
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/sweety_test
# DB_NAME_TEST=sweety_test

# JWT Secret for authentication tokens
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
