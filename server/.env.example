# Server Port
PORT=5000

# PostgreSQL Database Configuration
# You can provide either DATABASE_URL or individual DB_* variables
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/sweety
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=YOUR_PASSWORD
# DB_NAME=sweety

# Test Database Configuration (used by Jest tests)
DATABASE_URL_TEST=postgresql://postgres:YOUR_PASSWORD@localhost:5432/sweety_test
# DB_NAME_TEST=sweety_test

# JWT Secret for authentication tokens
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
